---
import TagLink from '@/components/tags/TagLink.astro'
import { getEntrySection, getTagUrl, type TaggedEntry } from '@/utils/tags'

interface Props {
  post: TaggedEntry
  class?: string
}

const { post, class: className } = Astro.props
---

{post.data.tags.length > 0 && (
  <ul class:list={['tag-links not-prose flex flex-wrap', className]} aria-label='标签' data-pagefind-ignore>
    {post.data.tags.map((tag) => (
      <li>
        <TagLink
          href={getTagUrl(getEntrySection(post), tag)}
          data-pagefind-filter={`标签:${tag}`}
        >{tag}</TagLink>
      </li>
    ))}
  </ul>
)}

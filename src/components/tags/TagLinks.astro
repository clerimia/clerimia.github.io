---
import { Button } from 'astro-pure/user'
import { getEntrySection, getTagUrl, type TaggedEntry } from '@/utils/tags'

interface Props {
  post: TaggedEntry
  class?: string
}

const { post, class: className } = Astro.props
---

{post.data.tags.length > 0 && (
  <ul class:list={['not-prose flex flex-wrap gap-2', className]} aria-label='标签'>
    {post.data.tags.map((tag) => (
      <li>
        <Button title={tag} href={getTagUrl(getEntrySection(post), tag)} variant='pill' data-pagefind-filter='标签' />
      </li>
    ))}
  </ul>
)}

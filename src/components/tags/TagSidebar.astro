---
import { Button, Icon } from 'astro-pure/user'
import TextArrowLink from '@/components/TextArrowLink.astro'
import { getSectionTags, getTagUrl, sectionTitles, type ContentSection } from '@/utils/tags'

interface Props {
  section: ContentSection
}

const { section } = Astro.props
const tags = await getSectionTags(section)
---

{tags.length > 0 && (
  <aside class='animate min-w-0' id='sidebar' aria-label={`${sectionTitles[section]} 标签`}>
    <h2 class='mb-4 flex items-center text-lg font-medium'>
      <Icon name='tag-2' class='me-2' />
      Tags
    </h2>
    <ul class='tag-entries text-bgColor flex flex-wrap gap-2'>
      {tags.slice(0, 50).map(([tag]) => (
        <li><Button title={tag} href={getTagUrl(section, tag)} variant='pill' /></li>
      ))}
    </ul>
    <span class='mt-4 block sm:text-end'>
      <TextArrowLink ariaLabel={`View all ${section} categories`} href={getTagUrl(section)}>
        查看全部
      </TextArrowLink>
    </span>
  </aside>
)}

<style>
  .tag-entries :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
  }
</style>

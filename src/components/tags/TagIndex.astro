---
import TagLink from '@/components/tags/TagLink.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { getSectionTags, getTagUrl, sectionTitles, type ContentSection } from '@/utils/tags'

interface Props {
  section: ContentSection
}

const { section } = Astro.props
const tags = await getSectionTags(section)
const title = `${sectionTitles[section]} · Tags`
---

<PageLayout meta={{ title, description: `${sectionTitles[section]} 的全部标签。` }} back={`/${section}`}>
  <main class='site-page-main'>
    <h1 class='mb-6 text-3xl font-medium'>{title}</h1>
    {tags.length > 0 ? (
      <ul class='tag-index flex flex-wrap'>
        {tags.map(([tag, count]) => (
          <li>
            <TagLink href={getTagUrl(section, tag)}>
              {tag} <span class='tag-index__count'>{count}</span>
            </TagLink>
          </li>
        ))}
      </ul>
    ) : <p class='text-muted-foreground'>还没有标签。</p>}
  </main>
</PageLayout>

<style>
  .tag-index__count {
    margin-inline-start: 4px;
    color: hsl(var(--muted-foreground));
    font-size: var(--font-meta);
  }
</style>

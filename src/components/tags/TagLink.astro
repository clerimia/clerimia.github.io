---
interface Props {
  href: string
  class?: string
  /** Extra attributes such as data-pagefind-filter. */
  [key: string]: unknown
}

const { href, class: className, ...attrs } = Astro.props
---

<a class:list={['tag-pill', className]} {href} data-astro-prefetch {...attrs}>
  <span><slot /></span>
</a>

<style>
  /* One tag action, one form: a compact badge inside a 44px target. */
  .tag-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 7px;
    color: hsl(var(--muted-foreground));
    font-size: var(--font-meta);
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--motion-feedback) var(--motion-feedback-easing);
  }

  .tag-pill > span {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 4px 9px;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-code);
  }

  .tag-pill:hover,
  .tag-pill:focus-visible {
    color: hsl(var(--primary));
  }

  .tag-pill:active {
    color: hsl(var(--primary-active));
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-pill { transition: none; }
  }
</style>

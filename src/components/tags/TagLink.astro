---
import { Badge } from '@/components/ui/badge'

interface Props {
  href: string
  class?: string
  /** Extra attributes such as data-pagefind-filter. */
  [key: string]: unknown
}

const { href, class: className, ...attrs } = Astro.props
---

<a class:list={['tag-pill group', className]} {href} data-astro-prefetch {...attrs}>
  <Badge
    variant='outline'
    className='rounded-sm px-[9px] py-1 font-normal text-muted-foreground transition-colors group-hover:border-primary group-hover:text-primary group-focus-visible:border-primary group-focus-visible:text-primary group-active:text-primary-active'
  >
    <slot />
  </Badge>
</a>

<style>
  /* One tag action, one form: a compact Badge inside a control-height target. */
  .tag-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--control-height);
    min-height: var(--control-height);
    padding: 5px;
    text-decoration: none;
  }
</style>

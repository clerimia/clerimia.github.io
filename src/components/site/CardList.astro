---
// Adapted from Astro Pure 1.4.7 (CWorld), Apache-2.0.
// Modified to retain only the static policy list.
import type { CardListData } from '@/lib/site-types'
import { cn } from '@/lib/ui'

import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'

import CardListChildren from './CardListChildren.astro'

type Props = CardListData & { class?: string }
const { title, list, class: className } = Astro.props
---

<Card
  className={cn(
    'not-prose my-3 gap-2 rounded-xl bg-transparent px-4 py-3 text-foreground sm:py-4',
    className
  )}
>
  <CardHeader className='p-0'>
    <CardTitle className='text-lg font-medium'>{title}</CardTitle>
  </CardHeader>
  <CardContent className='p-0'>
    <CardListChildren children={list} main />
  </CardContent>
</Card>

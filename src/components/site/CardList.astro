---
// Adapted from Astro Pure 1.4.7 (CWorld), Apache-2.0.
// Modified to retain only the static policy list; see docs/rebuild/third-party.md.
import type { CardListData } from '@/lib/site-types'
import { cn } from '@/lib/ui'
import CardListChildren from './CardListChildren.astro'

type Props = CardListData & { class?: string; style?: string | Record<string, string> }
const { title, list, class: className, ...props } = Astro.props
---

<div class={cn('not-prose my-3 flex flex-col gap-y-2 rounded-xl border px-4 py-3 sm:py-4', className)} {...props}>
  <p class='text-lg font-medium text-foreground'>{title}</p>
  <CardListChildren children={list} main />
</div>

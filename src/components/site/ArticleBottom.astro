---
// Adapted from Astro Pure 1.4.7 (CWorld), Apache-2.0.
// Modified for local imports and site-only APIs.
import type { CollectionEntry, CollectionKey } from 'astro:content'
import { cn } from '@/lib/ui'
import { ChevronLeft, ChevronRight } from 'lucide-react'

import { buttonVariants } from '@/components/ui/button'

type Props = {
  id: string
  collections: CollectionEntry<CollectionKey>[]
  class?: string
}

// Get the requested entry
const { id, collections, class: className } = Astro.props
const path = Astro.url.pathname.split('/').slice(0, 2).join('/')

// Get the next and prev entries (modulo to wrap index)
const index = collections.findIndex((x) => x.id === id)
const prev = collections[index - 1]
const next = collections[index + 1]
---

<div class={cn('flex max-sm:flex-col sm:justify-between gap-2', className)}>
  <span class='min-w-0'>
    {
      prev && (
        <a
          class={cn(
            buttonVariants({ variant: 'ghost' }),
            'group h-auto max-w-full justify-start py-2 max-sm:max-w-[80%]'
          )}
          data-slot='button'
          data-variant='ghost'
          href={`${path}/${prev.id}`}
        >
          <ChevronLeft
            aria-hidden='true'
            className='text-muted-foreground transition-colors group-hover:text-primary'
          />
          <span class='truncate font-medium'>{prev.data.title}</span>
        </a>
      )
    }
  </span>

  <span class='min-w-0 max-sm:self-end'>
    {
      next && (
        <a
          class={cn(
            buttonVariants({ variant: 'ghost' }),
            'group h-auto max-w-full justify-end py-2 text-right max-sm:max-w-[80%]'
          )}
          data-slot='button'
          data-variant='ghost'
          href={`${path}/${next.id}`}
        >
          <span class='truncate font-medium'>{next.data.title}</span>
          <ChevronRight
            aria-hidden='true'
            className='text-muted-foreground transition-colors group-hover:text-primary'
          />
        </a>
      )
    }
  </span>
</div>

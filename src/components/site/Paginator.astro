---
// Adapted from Astro Pure 1.4.7 (CWorld), Apache-2.0.
// Modified for local imports and site-only APIs.
import {
  Pagination,
  PaginationContent,
  PaginationItem,
  PaginationLink
} from '@/components/ui/pagination'

type PaginationTarget = {
  url: string
  text?: string
  srLabel?: string
}

interface Props {
  nextUrl?: PaginationTarget
  prevUrl?: PaginationTarget
}

const { nextUrl, prevUrl } = Astro.props
---

{
  (prevUrl || nextUrl) && (
    <Pagination className='mt-4 sm:mt-6' aria-label='分页'>
      <PaginationContent className='w-full justify-between'>
        {prevUrl && (
          <PaginationItem>
            <PaginationLink
              href={prevUrl.url}
              size='default'
              className='px-0 text-muted-foreground hover:bg-transparent hover:text-primary'
              data-astro-prefetch
            >
              {prevUrl.srLabel && <span class='sr-only'>{prevUrl.srLabel}</span>}
              {prevUrl.text ? prevUrl.text : 'Previous'}
            </PaginationLink>
          </PaginationItem>
        )}
        {nextUrl && (
          <PaginationItem className='ms-auto'>
            <PaginationLink
              href={nextUrl.url}
              size='default'
              className='px-0 text-muted-foreground hover:bg-transparent hover:text-primary'
              data-astro-prefetch
            >
              {nextUrl.srLabel && <span class='sr-only'>{nextUrl.srLabel}</span>}
              {nextUrl.text ? nextUrl.text : 'Next'}
            </PaginationLink>
          </PaginationItem>
        )}
      </PaginationContent>
    </Pagination>
  )
}

---
import { Image } from 'astro:assets'
import { type CollectionEntry, render } from 'astro:content'
import FormattedDate from '@/components/site/FormattedDate.astro'
import Icon from '@/components/site/Icon.astro'
import DirectionalArrow from '@/components/site/DirectionalArrow.astro'
import TagLink from '@/components/tags/TagLink.astro'
import { getMusingUrl } from '@/lib/posts'
import { getEntrySection, getTagUrl } from '@/lib/tags'

type Props = {
  post: CollectionEntry<'blog'> | CollectionEntry<'musings'>
  detailed?: boolean
  description?: string
  /** Compact row, e.g. for year archives. */
  plain?: boolean
  class?: string
}

const { post, detailed = false, description = post.data.description, plain = false, class: className } = Astro.props
const { data } = post
const { remarkPluginFrontmatter } = await render(post)
const postDate = data.updatedDate ?? data.publishDate
---

<li class:list={['post-preview', { 'post-preview--plain': plain, 'post-preview--card': detailed }, className]}>
  <a class='post-preview__link direction-arrow-trigger' href={getMusingUrl(post)} data-astro-prefetch>
    <div class='post-preview__content'>
      <FormattedDate class='post-preview__date' date={postDate} />
      {data.title && (
        <div class='post-preview__heading'>
          <div class='post-preview__title'>
            {data.draft && <span>(草稿) </span>}{data.title}
          </div>
          <DirectionalArrow />
        </div>
      )}
      {detailed && description && <p class='post-preview__summary'>{description}</p>}
      {detailed && (
        <div class='post-preview__meta'>
          <span><Icon name='time' />{remarkPluginFrontmatter.minutesRead}</span>
          {data.language && <span><Icon name='earth' />{data.language}</span>}
        </div>
      )}
    </div>
    {detailed && data.heroImage && (
      <Image
        class='post-preview__image'
        alt={data.heroImage.alt ?? data.title ?? ''}
        loading='lazy'
        {...data.heroImage}
      />
    )}
  </a>

  {detailed && data.tags.length > 0 && (
    <ul class='post-preview__tags' aria-label='文章标签'>
      {data.tags.map((tag: string) => (
        <li><TagLink href={getTagUrl(getEntrySection(post), tag)}>{tag}</TagLink></li>
      ))}
    </ul>
  )}

  <style>
    .post-preview {
      padding: 0 0 var(--space-3);
      border-bottom: 1px solid hsl(var(--border));
    }

    .post-preview__link {
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      padding: var(--space-4) 0 var(--space-2);
      color: hsl(var(--foreground));
      text-decoration: none;
    }

    .post-preview__content {
      flex: 1;
      min-width: 0;
    }

    .post-preview__content :global(.post-preview__date) {
      display: block;
      margin-bottom: var(--space-2);
      color: hsl(var(--muted-foreground));
      font-size: var(--font-meta);
      line-height: 1.5;
    }

    .post-preview__heading {
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .post-preview__title {
      flex: 1;
      min-width: 0;
      color: hsl(var(--foreground));
      font-size: var(--font-item-title);
      font-weight: 600;
      line-height: 1.45;
    }

    .post-preview__heading :global(.direction-arrow) {
      margin-top: 3px;
    }

    .post-preview__summary {
      margin: var(--space-2) 0 0;
      color: hsl(var(--muted-foreground));
      font-size: var(--font-ui);
      line-height: 1.6;
    }

    .post-preview__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      margin-top: var(--space-2);
      color: hsl(var(--muted-foreground));
      font-size: var(--font-meta);
    }

    .post-preview__meta span {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
    }

    .post-preview__meta :global(svg) {
      width: 16px;
      height: 16px;
    }

    .post-preview__image {
      width: 112px;
      height: 84px;
      flex: none;
      object-fit: cover;
      border-radius: var(--radius-control);
    }

    .post-preview__link:hover .post-preview__title,
    .post-preview__link:focus-visible .post-preview__title {
      color: hsl(var(--primary));
    }
    .post-preview--card .post-preview__link:hover .post-preview__title,
    .post-preview--card .post-preview__link:focus-visible .post-preview__title {
      color: hsl(var(--foreground));
    }

    .post-preview--card {
      position: relative;
      padding: var(--space-5) var(--space-6);
      border: 1px solid hsl(var(--border));
      border-radius: var(--radius-panel);
      background: transparent;
      transition: background-color var(--motion-feedback) var(--motion-feedback-easing);
    }

    @media (hover: hover) {
      .post-preview--card:has(.post-preview__link:hover) {
        background: hsl(var(--accent));
      }
    }
    .post-preview--card:has(.post-preview__link:focus-visible) {
      background: hsl(var(--accent));
    }
    @media (prefers-reduced-motion: reduce) {
      .post-preview--card { transition: none; }
    }

    .post-preview--card .post-preview__link { padding: 0; }
    .post-preview--card .post-preview__date { font-variant-numeric: tabular-nums; }

    /* 整卡链接与标签互为同级，标签自己的命中区位于覆盖层之上。 */
    .post-preview--card .post-preview__link::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
    }
    .post-preview--card:has(.post-preview__link:focus-visible) {
      outline: 2px solid hsl(var(--ring));
      outline-offset: 4px;
    }
    .post-preview--card .post-preview__link:focus-visible { outline: none; }
    .post-preview--card .post-preview__title,
    .post-preview--card .post-preview__summary { overflow-wrap: anywhere; }

    .post-preview__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      margin: var(--space-2) -7px -7px;
      padding: 0;
      list-style: none;
    }

    /* 标签覆盖层位于整卡链接之上，保持独立命中区。 */
    .post-preview__tags :global(.tag-pill) {
      position: relative;
      z-index: 1;
    }

    .post-preview--plain {
      padding-bottom: 0;
    }

    @media (max-width: 680px) {
      .post-preview--card { padding: 18px; }
      .post-preview__image {
        width: 72px;
        height: 72px;
      }
    }
  </style>
</li>

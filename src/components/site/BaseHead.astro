---
import { buildJsonLd, serializeJsonLd } from '@/lib/seo'
import config from '@/site-config'

import type { SiteMeta } from '@/lib/site-types'

type Props = SiteMeta & {
  publishedDate?: string
  updatedDate?: string
  tags?: string[]
}

const { articleDate, description, ogImage, publishedDate, title, updatedDate, tags } = Astro.props

const siteTitle = `${title} ${config.titleDelimiter} ${config.title}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(ogImage ? ogImage : config.socialCard, Astro.url).href
const iconUrl = (path: string) => `${path}?v=clerimia-20261029`
const noindex =
  Astro.url.pathname === '/search' ||
  Astro.url.pathname === '/404' ||
  Astro.url.pathname === '/design'
const isArticle = Boolean(articleDate || publishedDate)
const jsonLd = buildJsonLd({
  site: Astro.site,
  pathname: Astro.url.pathname,
  title,
  description,
  image: socialImageURL,
  publishedDate: publishedDate ?? articleDate,
  updatedDate,
  tags
})
---

<meta charset='utf-8' />
<meta
  content='width=device-width, initial-scale=1.0, shrink-to-fit=no, viewport-fit=cover'
  name='viewport'
/>
<meta content='IE=edge' http-equiv='X-UA-Compatible' />
<title>{siteTitle}</title>

{/* Icons / Favicon */}
<link rel='icon' type={config.favicon.type} href={iconUrl(config.favicon.href)} />
<link rel='shortcut icon' type={config.favicon.type} href={iconUrl(config.favicon.href)} />
<link rel='icon' type='image/png' sizes='32x32' href={iconUrl('/favicon/favicon-32x32.png')} />
<link rel='icon' type='image/png' sizes='16x16' href={iconUrl('/favicon/favicon-16x16.png')} />
<link rel='apple-touch-icon' sizes='180x180' href={iconUrl('/favicon/apple-touch-icon.png')} />
<link rel='manifest' href={iconUrl('/favicon/site.webmanifest')} />

<link rel='preconnect' href='https://fonts.googleapis.com' />
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
<link
  rel='stylesheet'
  href='https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap'
/>

{/* Font preloads (self-hosted, same as the template site) */}
<link rel='preload' href='/fonts/Satoshi-Variable.ttf' as='font' type='font/ttf' crossorigin />
<style>
  body {
    font-family: Satoshi, system-ui, sans-serif;
  }
</style>

{/* Canonical URL */}
<link rel='canonical' href={canonicalURL} />
{noindex && <meta name='robots' content='noindex, follow' />}

{/* Primary Meta Tags */}
<meta content={siteTitle} name='title' />
<meta content={description} name='description' data-pagefind-meta='description[content]' />
<meta content={config.author} name='author' />

{/* Theme Color */}
<meta name='theme-color' content='#f9fcf9' />
<meta name='color-scheme' content='light dark' />

{/* Open Graph / Facebook */}
<meta content={isArticle ? 'article' : 'website'} property='og:type' />
<meta content={title} property='og:title' />
<meta content={description} property='og:description' />
<meta content={canonicalURL} property='og:url' />
<meta content={config.title} property='og:site_name' />
<meta content={config.locale.attrs} property='og:locale' />
<meta content={socialImageURL} property='og:image' />
<meta content={`${title} ${config.titleDelimiter} ${config.title}`} property='og:image:alt' />
<meta content='1200' property='og:image:width' />
<meta content='630' property='og:image:height' />
{
  isArticle && (
    <>
      <meta content={config.author} property='article:author' />
      <meta content={publishedDate ?? articleDate} property='article:published_time' />
      <meta
        content={updatedDate ?? publishedDate ?? articleDate}
        property='article:modified_time'
      />
      {tags?.map((tag) => (
        <meta content={tag} property='article:tag' />
      ))}
    </>
  )
}

{/* Twitter */}
<meta content='summary_large_image' property='twitter:card' />
<meta content={canonicalURL} property='twitter:url' />
<meta content={title} property='twitter:title' />
<meta content={description} property='twitter:description' />
<meta content={socialImageURL} property='twitter:image' />
<meta content={`${title} ${config.titleDelimiter} ${config.title}`} property='twitter:image:alt' />

{/* Sitemap */}
<link href='/sitemap-index.xml' rel='sitemap' />

{/* RSS auto-discovery */}
<link
  rel='alternate'
  type='application/rss+xml'
  title={config.title}
  href={`${Astro.site}rss.xml`}
/>

{/* Structured data: site identity plus article metadata when present */}
<script is:inline type='application/ld+json' set:html={serializeJsonLd(jsonLd)} />

<meta content={Astro.generator} name='generator' />

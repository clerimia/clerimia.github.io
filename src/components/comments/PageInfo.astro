---
import { cn } from 'astro-pure/utils'

interface Props {
  /** 兼容主题原有 API：本站未接入浏览量统计，故忽略 */
  view?: boolean
  /** 是否显示留言入口 */
  comment?: boolean
  class?: string
}

const { comment, class: className, ...props } = Astro.props
---

{
  comment && (
    <div class={cn('comment-action', className)} {...props}>
      <a class='comment-link' href='#comments' aria-label='参与讨论，跳转到文章评论区'>
        <svg aria-hidden='true' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>
          <path d='M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z' />
        </svg>
        <span>参与讨论</span>
        <span class='comment-arrow' aria-hidden='true'>↓</span>
      </a>
    </div>
  )
}

<style>
  .comment-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 999px;
    background: transparent;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
    font-style: normal;
    line-height: 1.5;
    text-decoration: none;
    transition: background-color 150ms, border-color 150ms, color 150ms;
  }
  .comment-link:hover {
    border-color: hsl(var(--foreground) / 0.22);
    background: hsl(var(--foreground) / 0.035);
    color: hsl(var(--foreground));
  }
  .comment-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .comment-arrow { opacity: 0.65; }
  @media (prefers-reduced-motion: reduce) {
    .comment-link { transition: none; }
  }
</style>

---
import TextArrowLink from '@/components/site/TextArrowLink.astro'
import { cn } from '@/lib/ui'

interface Props {
  view?: boolean
  comment?: boolean
  class?: string
}

const { comment, view: _view, class: className, ...props } = Astro.props
---

{
  comment && (
    <div class={cn('page-info', className)} data-pagefind-ignore {...props}>
      <TextArrowLink href='#comments' ariaLabel='跳转到文章评论区'>
        <span data-comment-count>评论</span>
      </TextArrowLink>
    </div>
  )
}

---
import { cn } from 'astro-pure/utils'

interface Props {
  view?: boolean
  comment?: boolean
  class?: string
}

const { comment, view: _view, class: className, ...props } = Astro.props
---

{
  comment && (
    <div class={cn('page-info', className)} data-pagefind-ignore {...props}>
      <a class='comment-link' href='#comments' aria-label='跳转到文章评论区'>
        <span data-comment-count>评论</span>
      </a>
    </div>
  )
}

<style>
  .comment-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-muted);
    font-size: var(--font-ui);
    text-decoration: none;
    transition: color var(--motion-feedback) var(--motion-feedback-easing);
  }
  .comment-link:hover,
  .comment-link:focus-visible {
    color: var(--color-action);
  }
  .comment-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .comment-link { transition: none; }
  }
</style>

---
interface Props {
  title: string
  class?: string
}
const { title, class: className } = Astro.props
---

<details class:list={['link-disclosure not-prose', className]}>
  <summary>
    <span class='link-disclosure__title'>{title}</span>
    <svg
      class='link-disclosure__chevron'
      xmlns='http://www.w3.org/2000/svg'
      width='16'
      height='16'
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='2'
      stroke-linecap='round'
      stroke-linejoin='round'
      aria-hidden='true'
    >
      <polyline points='6 9 12 15 18 9'></polyline>
    </svg>
  </summary>
  <div class='link-disclosure__content'><slot /></div>
</details>

<style>
  .link-disclosure {
    margin-block: var(--space-4);
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-panel);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    list-style: none;
    color: hsl(var(--muted-foreground));
    font-size: var(--font-ui);
    cursor: pointer;
    transition: color var(--motion-feedback) var(--motion-feedback-easing);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: hsl(var(--primary));
  }
  summary:focus-visible {
    border-radius: var(--radius-panel);
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
  }
  .link-disclosure__chevron {
    flex: none;
    transition: transform var(--motion-overlay) var(--motion-overlay-easing);
  }
  details[open] .link-disclosure__chevron {
    transform: rotate(180deg);
  }
  .link-disclosure__content {
    padding: 0 var(--space-4) var(--space-3);
  }
  @media (prefers-reduced-motion: reduce) {
    summary,
    .link-disclosure__chevron {
      transition: none;
    }
  }
</style>

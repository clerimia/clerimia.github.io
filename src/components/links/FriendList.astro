---
import config from '@/site-config'

interface Friend {
  avatar: string
  avatar_cache?: { hash: string; path: string }
  name: string
  intro: string
  link: string
}
interface Props {
  title?: string
  list: { id_name: string; desc: string; link_list: Friend[] }
}
const { title, list } = Astro.props
const friends = [...list.link_list].sort(() => Math.random() - 0.5)
const avatarSrc = (friend: Friend) =>
  config.integ?.links?.cacheAvatar ? (friend.avatar_cache?.path ?? friend.avatar) : friend.avatar
---

{title && <h2 id={list.id_name}>{title}</h2>}
{
  friends.length ? (
    <ul class='friend-garden'>
      {friends.map((friend) => (
        <li>
          <a class='friend-plot' href={friend.link} target='_blank' rel='noopener noreferrer'>
            <span class='friend-plot__top'>
              <span class='friend-plot__avatar' aria-hidden='true'>
                <span>{friend.name.charAt(0)}</span>
                <img
                  src={avatarSrc(friend)}
                  alt=''
                  width={56}
                  height={56}
                  loading='lazy'
                  onerror="this.setAttribute('hidden', '')"
                />
              </span>
              <span class='friend-plot__identity'>
                <strong>{friend.name}</strong>
                <span class='friend-plot__host'>{new URL(friend.link).hostname}</span>
              </span>
            </span>
            <span class='friend-plot__description'>{friend.intro}</span>
            <span class='friend-plot__visit' aria-hidden='true'>
              <span>去串门</span>
              <span>→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class='garden-empty'>这里还空着。</p>
  )
}

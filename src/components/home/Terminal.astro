---
import '@/assets/styles/terminal.css'

interface Props {
  user?: string
  host?: string
  cwd?: string
  bannerTitle?: string
  bannerSub?: string
  authorName?: string
  authorDesc?: string
  /** 顶部欢迎语；传空字符串则只保留 banner */
  welcome?: string
  /** 可 cd 的栏目：{ blog: '/blog', ... } */
  routes?: Record<string, string>
  social?: Record<string, string>
  /** 是否内嵌在对话框里（隐藏自己的标题栏圆点，由对话框头部提供关闭等控件） */
  embedded?: boolean
}

const {
  user = 'guest',
  host = 'localhost',
  cwd = '~',
  bannerTitle = '',
  bannerSub = '',
  authorName = '',
  authorDesc = '',
  welcome,
  routes = {},
  social = {},
  embedded = false
} = Astro.props

const welcomeText =
  welcome !== undefined
    ? welcome
    : authorName
      ? `你好，我是 ${authorName}。输入 help 查看可用命令。`
      : '输入 help 查看可用命令。'

const lsColumns = 2
const quickCommands = ['help', 'ls', 'whoami']

const helpRows: Array<[string, string]> = [
  ['help', '显示帮助'],
  ['whoami', '关于我'],
  ['ls', '列出站点栏目'],
  ['cd <栏目>', '跳转，例如 cd blog'],
  ['theme [dark|light|system]', '切换主题'],
  ['social', '联系方式'],
  ['date', '当前时间'],
  ['echo <文本>', '回显文本'],
  ['clear', '清屏']
]
---

<div
  id='wt-shell'
  class:list={['wt-shell', { 'wt-shell--embedded': embedded }]}
  data-wt-shell
>
  {
    !embedded && (
      <div class='wt-titlebar'>
        <div class='wt-lights' aria-hidden='true'>
          <button
            type='button'
            class='wt-light wt-light--r'
            tabindex='-1'
            aria-label='关闭终端'
            data-wt='close'
          />
          <button
            type='button'
            class='wt-light wt-light--y'
            tabindex='-1'
            aria-label='最小化终端'
            data-wt='minimize'
          />
          <button
            type='button'
            class='wt-light wt-light--g'
            tabindex='-1'
            aria-label='最大化终端'
            data-wt='maximize'
          />
        </div>
        <div class='wt-title' data-wt='title' />
      </div>
    )
  }

  <div class='wt-body' data-wt='body'>
    <div class='wt-output' data-wt='output' role='log' aria-label='终端输出' aria-live='polite'>
      {
        bannerTitle && (
          <div class='wt-banner' data-wt='banner'>
            <span class='wt-banner-title'>{bannerTitle}</span>
            {bannerSub && <span class='wt-banner-sub'>{bannerSub}</span>}
          </div>
        )
      }
    </div>

    <div class='wt-input-row' data-wt='input-row'>
      <span class='wt-prompt' data-wt='prompt' aria-hidden='true'
        ><span class='wt-prompt-user'>{user}</span><span class='wt-prompt-at'>@</span><span
          class='wt-prompt-host'>{host}</span
        ><span class='wt-prompt-cwd'>{cwd}</span><span class='wt-prompt-sigil'>❯</span></span
      >
      <span class='wt-input-wrap'>
        <input
          class='wt-input'
          data-wt='input'
          spellcheck='false'
          autocomplete='off'
          autocapitalize='off'
          autocorrect='off'
          aria-label='终端输入'
          placeholder='help'
        />
        <span class='wt-block-caret' data-wt='caret' aria-hidden='true' />
      </span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ user, host, cwd, bannerTitle, bannerSub, welcomeText, routes, social, authorName, authorDesc, helpRows, lsColumns, quickCommands, embedded }}>
  ;(function () {
    var shell = document.querySelector('[data-wt-shell]')
    if (!shell) return

    var titleEl = shell.querySelector('[data-wt="title"]')
    var bodyEl = shell.querySelector('[data-wt="body"]')
    var outputEl = shell.querySelector('[data-wt="output"]')
    var inputRow = shell.querySelector('[data-wt="input-row"]')
    var inputEl = shell.querySelector('[data-wt="input"]')
    var promptEl = shell.querySelector('[data-wt="prompt"]')
    var blockCaret = shell.querySelector('[data-wt="caret"]')

    var history = []
    var histIdx = -1

    /* ===== 标题栏 ===== */
    function renderChrome() {
      if (!titleEl) return
      titleEl.textContent = ''
      var u = document.createElement('span')
      u.className = 'wt-tone-identity'
      u.textContent = user + '@' + host
      var sep = document.createElement('span')
      sep.className = 'wt-tone-muted'
      sep.textContent = ':'
      var p = document.createElement('span')
      p.className = 'wt-tone-muted'
      p.textContent = cwd
      titleEl.appendChild(u)
      titleEl.appendChild(sep)
      titleEl.appendChild(p)
    }

    /* ===== 输出行 ===== */
    function appendLine(text, tone, withPrompt) {
      var el = document.createElement('div')
      el.className = withPrompt ? 'wt-line wt-entry' : 'wt-line wt-tone-' + (tone || 'fg')
      if (withPrompt) {
        el.appendChild(promptEl.cloneNode(true))
        var t = document.createElement('span')
        t.className = 'wt-tone-fg'
        t.textContent = text
        el.appendChild(t)
      } else {
        el.textContent = text
      }
      outputEl.appendChild(el)
      scrollToBottom()
      return el
    }

    function appendNode(node) {
      outputEl.appendChild(node)
      scrollToBottom()
    }

    function scrollToBottom() {
      bodyEl.scrollTop = bodyEl.scrollHeight
    }

    /* ===== 光标定位（镜像量宽） ===== */
    var mirrorEl = document.createElement('span')
    mirrorEl.className = 'wt-input-mirror'
    mirrorEl.setAttribute('aria-hidden', 'true')
    shell.appendChild(mirrorEl)

    function syncCaret() {
      if (!blockCaret) return
      if (document.activeElement !== inputEl) {
        blockCaret.classList.remove('wt-block-caret--visible')
        return
      }
      var at = inputEl.selectionStart
      var collapsed = at === inputEl.selectionEnd
      if (at === null || !collapsed) {
        blockCaret.classList.remove('wt-block-caret--visible')
        return
      }
      blockCaret.classList.add('wt-block-caret--visible')
      mirrorEl.textContent = inputEl.value.slice(0, at)
      blockCaret.style.setProperty(
        '--wt-caret-x',
        mirrorEl.getBoundingClientRect().width - inputEl.scrollLeft + 'px'
      )
    }

    /* ===== 命令实现 ===== */
    function emit(text, tone) {
      appendLine(text, tone || 'fg', false)
    }

    function emitColumns(items, columns) {
      /* 对齐为等宽多列，靠 padding 不靠表格 */
      var maxLen = 0
      items.forEach(function (s) {
        if (s.length > maxLen) maxLen = s.length
      })
      var rows = Math.ceil(items.length / columns)
      for (var r = 0; r < rows; r++) {
        var parts = []
        for (var c = 0; c < columns; c++) {
          var i = c * rows + r
          if (i < items.length) parts.push(items[i].padEnd(maxLen + 2, ' '))
        }
        emit(parts.join('').trimEnd(), 'fg')
      }
    }

    function emitHelp() {
      var dl = document.createElement('dl')
      dl.className = 'wt-help-list'
      helpRows.forEach(function (pair) {
        var row = document.createElement('div')
        var dt = document.createElement('dt')
        var dd = document.createElement('dd')
        dt.textContent = pair[0]
        dd.textContent = pair[1]
        row.appendChild(dt)
        row.appendChild(dd)
        dl.appendChild(row)
      })
      appendNode(dl)
    }

    function run(raw) {
      var cmd = String(raw || '').trim()
      appendLine(cmd, 'fg', true)
      if (!cmd) return

      var parts = cmd.split(/\s+/)
      var name = parts[0]
      var arg = parts.slice(1).join(' ').trim()
      var key = name.toLowerCase()

      switch (key) {
        case 'help':
          emitHelp()
          break

        case 'whoami':
          emit(authorName || '-', 'identity')
          if (authorDesc) emit(authorDesc, 'muted')
          break

        case 'ls': {
          var names = Object.keys(routes)
          if (!names.length) {
            emit('没有可跳转的栏目。', 'muted')
          } else {
            emitColumns(
              names.map(function (n) {
                return n
              }),
              lsColumns
            )
            emit("Tip: use 'cd <栏目>' to navigate.", 'muted')
          }
          break
        }

        case 'cd': {
          if (!arg) {
            emit('usage: cd <栏目>', 'warn')
            break
          }
          var target = routes[arg.replace(/^\//, '')]
          if (target) {
            emit('→ ' + target, 'ok')
            window.setTimeout(function () {
              window.location.href = target
            }, 320)
          } else {
            emit('cd: no such directory: ' + arg, 'err')
          }
          break
        }

        case 'theme': {
          var mode = arg.toLowerCase()
          var root = document.documentElement
          document.dispatchEvent(new Event('site:theme-changing'))
          if (mode === 'dark') root.classList.add('dark')
          else if (mode === 'light') root.classList.remove('dark')
          else if (mode === 'system') {
            root.classList.toggle(
              'dark',
              window.matchMedia('(prefers-color-scheme: dark)').matches
            )
          } else {
            root.classList.toggle('dark')
          }
          var nowDark = root.classList.contains('dark')
          try {
            localStorage.setItem('theme', nowDark ? 'dark' : 'light')
          } catch (e) {}
          document.dispatchEvent(new Event('site:theme-change'))
          emit('theme → ' + (nowDark ? 'dark' : 'light'), 'ok')
          break
        }

        case 'social': {
          var keys = Object.keys(social || {})
          if (!keys.length) {
            emit('未配置社交链接。', 'muted')
          } else {
            keys.forEach(function (k) {
              emit(k + '  ' + social[k], 'fg')
            })
          }
          break
        }

        case 'date':
          emit(new Date().toLocaleString('zh-CN'), 'fg')
          break

        case 'echo':
          emit(arg || '', 'fg')
          break

        case 'clear': {
          outputEl.querySelectorAll('.wt-line, .wt-help-list, .wt-banner').forEach(function (n) {
            n.remove()
          })
          break
        }

        case 'sudo':
          emit('你已经是这里的主人了，不需要 sudo。', 'warn')
          break

        default:
          emit('command not found: ' + name, 'err')
          emit("输入 help 查看可用命令", 'muted')
      }
    }

    /* ===== 输入事件 ===== */
    function clearInput() {
      inputEl.value = ''
      syncCaret()
    }

    /* 聚焦时清空占位符，把状态交给光标；失焦且为空时恢复 */
    inputEl.addEventListener('focus', function () {
      inputEl.placeholder = ''
    })
    inputEl.addEventListener('blur', function () {
      if (!inputEl.value) inputEl.placeholder = 'help'
    })

    inputEl.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.isComposing) {
        var value = inputEl.value
        if (value.trim()) history.push(value)
        histIdx = -1
        clearInput()
        run(value)
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        if (!history.length) return
        histIdx = histIdx < 0 ? history.length - 1 : Math.max(0, histIdx - 1)
        inputEl.value = history[histIdx]
        window.requestAnimationFrame(function () {
          inputEl.setSelectionRange(inputEl.value.length, inputEl.value.length)
          syncCaret()
        })
      } else if (e.key === 'ArrowDown') {
        e.preventDefault()
        if (histIdx < 0) return
        var idx = histIdx + 1
        if (idx >= history.length) {
          histIdx = -1
          inputEl.value = ''
        } else {
          histIdx = idx
          inputEl.value = history[idx]
        }
        window.requestAnimationFrame(function () {
          inputEl.setSelectionRange(inputEl.value.length, inputEl.value.length)
          syncCaret()
        })
      }
    })

    ;['input', 'keyup', 'click', 'select', 'scroll'].forEach(function (event) {
      inputEl.addEventListener(event, syncCaret)
    })
    document.addEventListener('selectionchange', function () {
      if (document.activeElement === inputEl) syncCaret()
    })

    /* 横向滚动时定期校正 */
    var followTimer = 0
    inputEl.addEventListener('focus', function () {
      syncCaret()
      window.clearInterval(followTimer)
      followTimer = window.setInterval(syncCaret, 260)
    })
    inputEl.addEventListener('blur', function () {
      window.clearInterval(followTimer)
      followTimer = 0
      syncCaret()
    })
    window.addEventListener('resize', syncCaret)

    /* 点输入行空白处也聚焦 */
    inputRow.addEventListener('click', function (e) {
      if (e.target === inputEl) return
      inputEl.focus()
    })
    shell.addEventListener('click', function (e) {
      if (e.target === bodyEl || e.target === outputEl) inputEl.focus()
    })

    /* ===== 标题栏按钮（非嵌入模式）：红色关闭可用，黄绿暂为占位 ===== */
    shell.querySelectorAll('[data-wt="close"]').forEach(function (el) {
      el.addEventListener('click', function () {
        document.dispatchEvent(new CustomEvent('wt:close'))
      })
    })

    /* ===== 首屏指引：告诉第一次来的人可以敲什么 ===== */
    function renderIntro() {
      if (welcomeText) appendLine(welcomeText, 'muted')
      var intro = document.createElement('div')
      intro.className = 'wt-line wt-intro'
      var label = document.createElement('span')
      label.className = 'wt-tone-muted'
      label.textContent = '试试 '
      intro.appendChild(label)
      quickCommands.forEach(function (cmd, i) {
        if (i) {
          var sep = document.createElement('span')
          sep.className = 'wt-tone-muted'
          sep.textContent = ' · '
          intro.appendChild(sep)
        }
        var button = document.createElement('button')
        button.type = 'button'
        button.className = 'wt-cmd'
        button.setAttribute('data-wt-command', cmd)
        button.textContent = cmd
        intro.appendChild(button)
      })
      appendNode(intro)
    }

    shell.querySelectorAll('[data-wt-command]').forEach(function (button) {
      button.addEventListener('click', function () {
        var cmd = button.getAttribute('data-wt-command')
        inputEl.focus()
        inputEl.value = ''
        syncCaret()
        run(cmd)
      })
    })

    /* ===== 初始 ===== */
    renderChrome()
    renderIntro()
    if (embedded) {
      /* 嵌入模式由对话框负责聚焦 */
    } else {
      inputEl.focus()
    }
  })()
</script>

---
/**
 * 静态跳转页。
 *
 * 之前这些路由用 `Astro.redirect()`，纯静态输出下只会产出一个裸的
 * `<meta http-equiv="refresh">` 片段（没有 <html>），于是每次构建 Pagefind 都会报
 * 「21 pages found without an <html> element」。
 * 这里显式渲染一个完整文档：有 <html>、有 canonical、有 noindex，还有一个可点的兜底链接。
 */
interface Props {
  /** 目标路径，例如 /musings/fear-of-forgetting */
  to: string
  /** 便于阅读的目标名称，缺省用路径 */
  label?: string
}

const { to, label = to } = Astro.props
const target = new URL(to, Astro.site)
---

<!doctype html>
<html lang='zh-CN' class='redirect-doc'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>跳转中… · {label}</title>
    <meta http-equiv='refresh' content={`0;url=${to}`} />
    <meta name='robots' content='noindex' />
    <link rel='canonical' href={target.href} />
  </head>
  <body data-pagefind-ignore>
    <main>
      <p>这个页面已经搬到 <a href={to}>{label}</a>，正在跳转…</p>
      <small>如果没有自动跳转，请点上面的链接。</small>
    </main>
    <style is:global>
      /* 注意：这里必须用 is:global，否则 Astro 会给样式加作用域属性，
         而 <head> 里的 <style> 会被 Vite 提升进共享 CSS chunk 供全站使用，
         未加作用域的 body 规则会污染整个站点（曾导致全站正文居中）。 */
      .redirect-doc,
      .redirect-doc body {
        height: 100%;
      }

      .redirect-doc {
        --redirect-canvas: #f9fcf9;
        --redirect-text: #263b2e;
        --redirect-muted: #536a5b;
        --redirect-action: #3f7050;
      }

      @media (prefers-color-scheme: dark) {
        .redirect-doc {
          --redirect-canvas: #191d1c;
          --redirect-text: #eaf1eb;
          --redirect-muted: #aebeb2;
          --redirect-action: #a9d8b4;
        }
      }

      .redirect-doc body {
        margin: 0;
        display: grid;
        place-items: start center;
        align-content: center;
        padding: 24px;
        background: var(--redirect-canvas);
        color: var(--redirect-text);
        font: 15px/1.7 "Satoshi", "Segoe UI", system-ui, "PingFang SC", "Microsoft YaHei", sans-serif;
        text-align: center;
      }

      .redirect-doc a {
        color: var(--redirect-action);
        text-underline-offset: 3px;
      }

      .redirect-doc p {
        margin: 0 0 6px;
      }

      .redirect-doc small {
        color: var(--redirect-muted);
      }
    </style>
  </body>
</html>

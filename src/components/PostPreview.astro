---
import { Image } from 'astro:assets'
import { type CollectionEntry, render } from 'astro:content'
import { FormattedDate, Icon } from 'astro-pure/user'
import { getMusingUrl } from '@/utils/posts'
import { getEntrySection, getTagUrl } from '@/utils/tags'

type Props = {
  post: CollectionEntry<'blog'> | CollectionEntry<'musings'>
  detailed?: boolean
  description?: string
  /** Compact row, e.g. for year archives. */
  plain?: boolean
  class?: string
}

const { post, detailed = false, description = post.data.description, plain = false, class: className } = Astro.props
const { data } = post
const { remarkPluginFrontmatter } = await render(post)
const postDate = data.updatedDate ?? data.publishDate
---

<li class:list={['post-preview', { 'post-preview--plain': plain }, className]}>
  <a class='post-preview__link' href={getMusingUrl(post)} data-astro-prefetch>
    <div class='post-preview__content'>
      <FormattedDate class='post-preview__date' date={postDate} />
      {data.title && (
        <div class='post-preview__title'>
          {data.draft && <span>(草稿) </span>}{data.title}
        </div>
      )}
      {detailed && description && <p class='post-preview__summary'>{description}</p>}
      {detailed && (
        <div class='post-preview__meta'>
          <span><Icon name='time' />{remarkPluginFrontmatter.minutesRead}</span>
          {data.language && <span><Icon name='earth' />{data.language}</span>}
        </div>
      )}
    </div>
    {detailed && data.heroImage && (
      <Image
        class='post-preview__image'
        alt={data.heroImage.alt ?? data.title ?? ''}
        loading='lazy'
        {...data.heroImage}
      />
    )}
    <span class='post-preview__arrow' aria-hidden='true'>↗</span>
  </a>

  {detailed && data.tags.length > 0 && (
    <ul class='post-preview__tags' aria-label='文章标签'>
      {data.tags.map((tag: string) => (
        <li><a href={getTagUrl(getEntrySection(post), tag)}>{tag}</a></li>
      ))}
    </ul>
  )}

  <style>
    .post-preview {
      padding: 0 0 var(--space-3);
      border-bottom: 1px solid var(--color-border);
    }

    .post-preview__link {
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      padding: var(--space-4) 0 var(--space-2);
      color: var(--color-text);
      text-decoration: none;
    }

    .post-preview__content {
      flex: 1;
      min-width: 0;
    }

    .post-preview__content :global(.post-preview__date) {
      display: block;
      margin-bottom: var(--space-2);
      color: var(--color-text-muted);
      font-size: var(--font-meta);
      line-height: 1.5;
    }

    .post-preview__title {
      color: var(--color-text);
      font-size: var(--font-item-title);
      font-weight: 600;
      line-height: 1.45;
    }

    .post-preview__summary {
      margin: var(--space-2) 0 0;
      color: var(--color-text-muted);
      font-size: var(--font-ui);
      line-height: 1.6;
    }

    .post-preview__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      margin-top: var(--space-2);
      color: var(--color-text-muted);
      font-size: var(--font-meta);
    }

    .post-preview__meta span {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
    }

    .post-preview__meta :global(svg) {
      width: 16px;
      height: 16px;
    }

    .post-preview__image {
      width: 112px;
      height: 84px;
      flex: none;
      object-fit: cover;
      border-radius: var(--radius-control);
    }

    .post-preview__arrow {
      color: var(--color-text-muted);
      font-size: 18px;
    }

    .post-preview__link:hover .post-preview__title,
    .post-preview__link:hover .post-preview__arrow {
      color: var(--color-action);
    }

    .post-preview__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-3);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .post-preview__tags a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--color-text-muted);
      font-size: var(--font-meta);
      text-decoration: underline;
      text-decoration-color: var(--color-border);
      text-underline-offset: 0.25em;
    }

    .post-preview__tags a:hover {
      color: var(--color-action);
      text-decoration-color: currentColor;
    }

    .post-preview--plain {
      padding-bottom: 0;
    }

    @media (max-width: 680px) {
      .post-preview__image {
        width: 72px;
        height: 72px;
      }
    }
  </style>
</li>

---
import { Image } from 'astro:assets'
import { type CollectionEntry, render } from 'astro:content'

import { cn } from 'astro-pure/utils'
import { getMusingUrl } from '@/utils/posts'
import { getEntrySection, getTagUrl } from '@/utils/tags'
import { Button, FormattedDate, Icon } from 'astro-pure/user'

type Props = {
  post: CollectionEntry<'blog'> | CollectionEntry<'musings'>
  detailed?: boolean
  /** Bare row without a card surface, e.g. for year archives. */
  plain?: boolean
  class?: string
}

const { post, detailed = false, plain = false, class: className } = Astro.props
const { data } = post
const { remarkPluginFrontmatter } = await render(post)
const postDate = data.updatedDate ?? data.publishDate
---

<li
  class:list={['post-preview', { 'post-preview--plain': plain }, className]}
  style={detailed &&
    data.heroImage?.color &&
    `--preview-highlight:color-mix(in srgb,${data.heroImage.color} 40%,hsl(var(--foreground)/var(--un-text-opacity,1)));
    --preview-highlight-bg:hsl(from ${data.heroImage.color} h s l/20%)`}
>
  <a
    class={cn(
      'post-preview__card block w-full relative group rounded-2xl border transition-colors ease-in-out px-5 py-2.5 hover:text-primary',
      detailed && 'max-sm:px-4 sm:py-5',
      detailed && data.heroImage && 'max-md:pt-24'
    )}
    href={getMusingUrl(post)}
    data-astro-prefetch
  >
    {
      detailed && data.heroImage && (
        <Image
          alt={data.heroImage.alt ?? data.title ?? ''}
          class='cover-image absolute end-0 top-0 z-0 h-2/3 w-full rounded-2xl object-cover opacity-50 transition-opacity duration-300 group-hover:opacity-70 md:h-full md:w-3/5'
          loading='eager'
          {...data.heroImage}
        />
      )
    }
    <div
      class={cn('relative flex flex-col gap-1', !detailed && 'sm:flex-row sm:items-center')}
      style='z-index:1'
    >
      <FormattedDate class='min-w-[95px] text-xs' date={postDate} />

      {/* title */}
      <div class='flex justify-between flex-grow'>
        <div class={detailed ? 'font-medium' : undefined}>
          {data.draft && <span class='text-red-500'>(草稿) </span>}
          {data.title}
        </div>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='preview-redirect my-1 stroke-muted-foreground group-hover:stroke-primary'
          ><line
            x1='5'
            y1='12'
            x2='19'
            y2='12'
            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
          ></line><polyline
            points='12 5 19 12 12 19'
            class='translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1'
          ></polyline></svg
        >
      </div>
      {
        detailed && (
          <>
            {/* desc */}
            <p
              class={cn(
                'line-clamp-2 text-sm text-muted-foreground sm:line-clamp-3',
                data.heroImage && 'sm:me-24'
              )}
            >
              {data.description}
            </p>
            <div class='py-2 flex items-center gap-2 text-sm italic leading-4 text-muted-foreground'>
              {/* reading time */}
              <span class='flex items-center gap-1'>
                <Icon name='time' class='size-4' />
                {remarkPluginFrontmatter.minutesRead}
              </span>
              {/* language */}
              {data.language && (
                <span class='flex items-center gap-1'>
                  <Icon name='earth' class='size-4' />
                  {data.language}
                </span>
              )}
            </div>
            {data.tags.length > 0 && (
              <object title='Tags' aria-label='Tags' aria-labelledby='Tags'>
                <ul class='tag-list mt-1 flex flex-wrap gap-1.5'>
                  {data.tags.map((tag: string) => (
                    <li>
                      <Button as='a' title={tag} href={getTagUrl(getEntrySection(post), tag)} variant='pill' />
                    </li>
                  ))}
                </ul>
              </object>
            )}
          </>
        )
      }
    </div>
  </a>

  <style>
    .post-preview {
      --preview-highlight-final: var( --preview-highlight, hsl(var(--primary) / var(--un-text-opacity, 1))
      );
    }
    /* Cards are the same paper, slightly shaded; bare rows are plain. */
    .post-preview .post-preview__card {
      background: var(--card-tint);
      border-color: var(--card-edge);
      transition:
        background 180ms ease,
        border-color 180ms ease,
        color 180ms ease;
    }
    .tag-list :global(a) {
      padding: 0.125rem 0.5rem;
      border-radius: 0.5rem;
      background: var(--chip-tint);
      border-color: transparent;
      font-size: 0.75rem;
      line-height: 1.25rem;
    }
    .post-preview:hover .post-preview__card {
      background: var(--card-tint-hover);
      border-color: var(--card-edge-hover);
    }
    .post-preview:hover {
      & .tag-list a {
        background-color: var(--preview-highlight-bg, var(--chip-tint-hover)) !important;
        border-color: var(--card-edge-hover);
      }
      & > a,
      & .tag-list a:hover {
        color: var(--preview-highlight-final) !important;
      }
      & > a .preview-redirect {
        stroke: var(--preview-highlight-final) !important;
      }
    }
    .cover-image {
      -webkit-mask-image: -webkit-linear-gradient(left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    }

    @media (max-width: 768px) {
      .cover-image {
        -webkit-mask-image: -webkit-linear-gradient(bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      }
    }
  </style>
</li>

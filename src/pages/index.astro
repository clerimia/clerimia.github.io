---
import { Image } from 'astro:assets'
import { Quote } from 'astro-pure/advanced'
import { Icon } from 'astro-pure/user'
import avatar from '@/assets/avatar.png'
import darkAvatar from '@/assets/avatar-dark.png'
import '@/assets/styles/home.css'
import PageLayout from '@/layouts/BaseLayout.astro'
import { getPosts, getPostUrl } from '@/utils/posts'

const posts = (await getPosts()).filter((post) => post.data.section === 'blog').slice(0, 3)
---

<PageLayout meta={{ title: 'Home' }}>
  <main>
    <section class='home-hero' aria-labelledby='home-hero-heading'>
      <div class='home-hero__main'>
        <div class='home-intro'>
          <h1 id='home-hero-heading'>
            你好，我是<br />
            <span class='home-name'>clerimia<span class='home-cursor' aria-hidden='true'>_</span></span>
          </h1>
          <p class='home-description'>
            合肥工业大学在读，关注 <strong>AI Agent</strong> 与 <strong>全栈开发</strong>。
          </p>
          <button
            class='home-terminal-launcher'
            data-terminal-trigger
            type='button'
            aria-haspopup='dialog'
            aria-controls='terminal-dialog'
            aria-expanded='false'
          >
            <span class='home-launcher-icon' aria-hidden='true'>&gt;_</span>
            <span class='home-launcher-copy'>
              <strong>探索这个站点</strong>
              <span>打开终端，认识这个小站</span>
            </span>
            <kbd aria-hidden='true'>`</kbd>
            <span class='home-launcher-arrow' aria-hidden='true'>↗</span>
          </button>
        </div>

        <aside class='home-profile' aria-label='个人名片'>
          <div class='home-avatar-frame'>
            <div class='home-avatar-mat'>
              <Image
                class='home-avatar--light'
                src={avatar}
                alt='clerimia 的头像'
                width={152}
                height={152}
                loading='eager'
              />
              <Image
                class='home-avatar--dark'
                src={darkAvatar}
                alt='clerimia 的深色模式头像'
                width={darkAvatar.width}
                height={darkAvatar.height}
                loading='eager'
              />
            </div>
          </div>
          <div class='home-location'><Icon name='location' /><span>安徽 · 宣城</span></div>
          <div class='home-social-links'>
            <a
              class='home-social-button'
              href='https://github.com/clerimia'
              target='_blank'
              rel='noopener noreferrer'
              aria-label='GitHub'
            ><Icon name='github' /></a>
            <a class='home-social-button' href='mailto:1937049668@qq.com' aria-label='发送邮件'
              ><Icon name='email' /></a
            >
            <a class='home-social-button' href='/rss.xml' aria-label='订阅 RSS'><Icon name='rss' /></a>
            <a class='home-about-link' href='/about' data-astro-prefetch>
              更多关于我 <span aria-hidden='true'>↗</span>
            </a>
          </div>
        </aside>
      </div>

      <div class='home-daily-note'>
        <div class='home-daily-label'>
          <span class='home-quote-symbol' aria-hidden='true'>“</span>
          <span>每日一言</span>
        </div>
        <div class='home-daily-content'><Quote /></div>
      </div>
    </section>

    <section class='home-latest' aria-labelledby='home-latest-heading'>
      <div class='home-section-heading'>
        <div>
          <h2 id='home-latest-heading'>最近写下的</h2>
        </div>
        <a href='/blog' data-astro-prefetch>全部文章 <span aria-hidden='true'>↗</span></a>
      </div>
      <div class='home-post-list'>
        {
          posts.map((post) => (
            <a class='home-post-row' href={getPostUrl(post)} data-astro-prefetch>
              <div class='home-post-date'>
                {post.data.publishDate
                  .toLocaleDateString('zh-CN', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    timeZone: 'Asia/Shanghai'
                  })
                  .replaceAll('/', '.')}
              </div>
              <div class='home-post-content'>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <span class='home-post-arrow' aria-hidden='true'>↗</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</PageLayout>

<script is:inline>
  const quoteSentence = document.getElementById('quote-sentence')
  if (quoteSentence && quoteSentence.textContent?.includes('Loading')) {
    quoteSentence.textContent =
      '我相信十年后的八月，我们还能再相遇。 ——secret base ～君がくれたもの～'
  }
</script>

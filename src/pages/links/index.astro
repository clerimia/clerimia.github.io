---
import links from '@/public/links.json'
import config from 'virtual:config'

import { Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import FriendList from '@/components/links/FriendList.astro'
import LinkDisclosure from '@/components/links/LinkDisclosure.astro'

const headings = [
  { depth: 2, slug: 'common-links', text: '友链' },
  { depth: 2, slug: 'special-links', text: '推荐链接' },
  { depth: 2, slug: 'apply-links', text: '申请友链' }
]

const { friends } = links
const linksConf = config.integ.links
const linkEditPage = 'https://github.com/clerimia/clerimia.github.io/blob/main/public/links.json'
---

<PageLayout title='Links' {headings} comment>
  <p>顺序随机。</p>
  <h2 id='common-links'>友链</h2>
  <FriendList list={friends[0]} />
  <LinkDisclosure title='暂时失联的站点'>
    <FriendList list={friends[1]} />
  </LinkDisclosure>
  <LinkDisclosure title='友链变动记录'>
    <Timeline events={linksConf.logbook} />
  </LinkDisclosure>

  <h2 id='special-links'>推荐链接</h2>
  <FriendList list={friends[2]} />

  <h2 id='apply-links'>申请友链</h2>
  <p>本站信息：</p>
  <dl class='friend-info not-prose'>
    {
      linksConf.applyTip.map(({ name, val }) => (
        <>
          <dt>{name}:</dt>
          <dd>
            <button
              class='friend-info__copy'
              type='button'
              data-copy-value={val}
              data-copy-label={name}
              aria-label={`复制 ${name}：${val}`}
              aria-describedby='friend-copy-status'
            >
              <samp>{val}</samp>
            </button>
          </dd>
        </>
      ))
    }
  </dl>
  <p class='friend-copy-status' id='friend-copy-status' role='status' aria-atomic='true'>
    点击或用键盘 Enter / Space 复制以上信息。
  </p>

  <p>
    可以通过下方留言，或到 <a href={linkEditPage} target='_blank'>仓库</a> 提交 PR 申请友链。要求：
  </p>
  <ul>
    <li>站点能正常访问，且有正式域名</li>
    <li>有一定数量的原创内容，且近期更新过</li>
    <li>内容合规</li>
  </ul>
</PageLayout>

<script>
  const status = document.getElementById('friend-copy-status')

  document.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach((button) => {
    button.addEventListener('click', async () => {
      if (button.getAttribute('aria-busy') === 'true') return
      button.setAttribute('aria-busy', 'true')
      if (status) status.textContent = '正在复制…'

      try {
        await navigator.clipboard.writeText(button.dataset.copyValue ?? '')
        if (status) status.textContent = `已复制 ${button.dataset.copyLabel}。`
      } catch {
        if (status) status.textContent = '复制失败，请选中上方内容手动复制。'
      } finally {
        button.removeAttribute('aria-busy')
      }
    })
  })
</script>

<style>
  .friend-info {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 4px 8px;
    margin: 20px 0 12px;
    padding-inline-start: 12px;
    border-inline-start: 3px solid var(--rule);
    color: var(--ink);
    font-size: 14px;
    font-style: normal;
  }

  .friend-info dt {
    padding-block: 6px;
    text-align: end;
  }

  .friend-info dd {
    min-width: 0;
    margin: 0;
  }

  .friend-info__copy {
    display: block;
    width: 100%;
    min-width: 0;
    padding: 6px 8px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: start;
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .friend-info__copy samp {
    font-family: ui-monospace, Consolas, monospace;
    user-select: text;
  }

  .friend-info__copy:hover {
    border-color: var(--card-edge-hover);
    background: var(--chip-tint);
  }

  .friend-info__copy:focus-visible {
    outline-offset: -2px;
  }

  .friend-copy-status {
    min-height: 2em;
    font-size: 13px;
  }
</style>

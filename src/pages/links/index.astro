---
import links from '@/public/links.json'
import config from '@/site-config'

import { Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { Comment } from '@/components/comments'
import FriendList from '@/components/links/FriendList.astro'
import GardenSprout from '@/components/links/GardenSprout.astro'
import GardenVine from '@/components/links/GardenVine.astro'
import LinkDisclosure from '@/components/links/LinkDisclosure.astro'

import '@/assets/styles/links.css'

const { friends } = links
const linksConf = config.integ.links!
const friendInfoText = linksConf.applyTip.map(({ name, val }) => `${name}: ${val}`).join('\n')
const linkEditPage = 'https://github.com/clerimia/clerimia.github.io/blob/main/public/links.json'
---

<PageLayout meta={{ title: 'Links' }} back='/'>
  <main class='site-page-main garden-page' data-pagefind-body>
    <header class='garden-header' id='content-header'>
      <h1>友链<GardenSprout /></h1>
      <p>一些我喜欢的小天地。</p>
      <GardenVine />
    </header>
    <section class='garden-friends' aria-label='朋友的博客'>
      <FriendList list={friends[0]} />
      <p class='garden-caption'><GardenSprout />让喜欢的站点，在这里拥有一小块地方。</p>
    </section>
    <div class='reading-column'>
      <LinkDisclosure title='暂时失联的站点'>
        <FriendList list={friends[1]} />
      </LinkDisclosure>
      <LinkDisclosure title='友链变动记录'>
        <Timeline events={linksConf.logbook} />
      </LinkDisclosure>
    </div>
    <section class='garden-section' aria-labelledby='special-links'>
      <h2 id='special-links'>推荐链接</h2>
      <FriendList list={friends[2]} />
    </section>
    <section class='garden-section reading-column' aria-labelledby='apply-links'>
      <h2 id='apply-links'>申请友链</h2>
      <div class='friend-info-heading'>
        <p>本站信息</p>
        <button
          class='friend-info-copy'
          type='button'
          data-copy-value={friendInfoText}
          data-copy-label='全部站点信息'
          aria-label='一键复制站点信息'
          aria-describedby='friend-copy-status'>一键复制</button
        >
      </div>
      <dl class='friend-info not-prose'>
        {
          linksConf.applyTip.map(({ name, val }) => (
            <>
              <dt>{name}:</dt>
              <dd>
                <samp>{val}</samp>
              </dd>
            </>
          ))
        }
      </dl>
      <p class='friend-copy-status' id='friend-copy-status' role='status' aria-atomic='true'>
        Name、Desc、Link、Avatar 将一起复制。
      </p>

      <p>
        可以通过下方留言，或到 <a href={linkEditPage} target='_blank' rel='noopener noreferrer'
          >仓库</a
        > 提交 PR 申请友链。要求：
      </p>
      <ul>
        <li>站点能正常访问，且有正式域名</li>
        <li>有一定数量的原创内容，且近期更新过</li>
        <li>内容合规</li>
      </ul>
    </section>
    <div class='garden-section reading-column' data-pagefind-ignore><Comment /></div>
  </main>
</PageLayout>

<script>
  const status = document.getElementById('friend-copy-status')

  document.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach((button) => {
    button.addEventListener('click', async () => {
      if (button.getAttribute('aria-busy') === 'true') return
      button.setAttribute('aria-busy', 'true')
      if (status) status.textContent = '正在复制…'

      try {
        await navigator.clipboard.writeText(button.dataset.copyValue ?? '')
        if (status) status.textContent = `已复制 ${button.dataset.copyLabel}。`
      } catch {
        if (status) status.textContent = '复制失败，请选中上方内容手动复制。'
      } finally {
        button.removeAttribute('aria-busy')
      }
    })
  })
</script>

<style>
  .friend-info-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .friend-info-heading p {
    margin: 0;
  }
  .friend-info-copy {
    min-height: 44px;
    padding: 6px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--font-ui);
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }
  .friend-info-copy:hover,
  .friend-info-copy:focus-visible {
    color: var(--color-action);
    border-color: var(--color-action);
  }
  .friend-info-copy:active {
    color: var(--color-action-active);
    border-color: var(--color-action-active);
  }
  .friend-info {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 4px 8px;
    margin: 20px 0 12px;
    padding-inline-start: 12px;
    border-inline-start: 3px solid var(--rule);
    color: var(--ink);
    font-size: 14px;
    font-style: normal;
  }

  .friend-info dt {
    padding-block: 6px;
    text-align: end;
  }

  .friend-info dd {
    min-width: 0;
    margin: 0;
  }

  .friend-info samp {
    display: block;
    width: 100%;
    min-width: 0;
    padding: 6px 8px;
    color: inherit;
    font: inherit;
    text-align: start;
    overflow-wrap: anywhere;
    font-family: ui-monospace, Consolas, monospace;
    user-select: text;
  }

  .friend-copy-status {
    min-height: 2em;
    font-size: 13px;
  }
</style>

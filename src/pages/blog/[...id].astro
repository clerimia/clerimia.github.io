---
import { type CollectionEntry, render } from 'astro:content'

import { getPosts, getPostUrl } from '@/utils/posts'
import PostLayout from '@/layouts/BlogPost.astro'

export const prerender = true

export async function getStaticPaths() {
  const allPosts = await getPosts()
  const posts = allPosts.filter((post) => post.data.section === 'blog')
  return allPosts.map((post) => ({
    params: { id: post.id },
    props: { post, posts }
  }))
}

type Props = {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
}

const { post, posts } = Astro.props
// Keep previously published links working after a post moves to the essays section.
if (post.data.section === 'essays') return Astro.redirect(getPostUrl(post), 301)
const { Content, headings, remarkPluginFrontmatter } = await render(post)
---

<PostLayout {post} {posts} {headings} {remarkPluginFrontmatter}>
  <Content />
</PostLayout>

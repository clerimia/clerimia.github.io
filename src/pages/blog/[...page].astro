---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator } from 'astro-pure/components/pages'
import PostPreview from '@/components/PostPreview.astro'
import TextArrowLink from '@/components/TextArrowLink.astro'
import TagSidebar from '@/components/tags/TagSidebar.astro'
import { getPosts } from '@/utils/posts'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = await getPosts('blog')
  const collectionsCount = collections.length
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { collectionsCount }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  collectionsCount: number
}

const { page, collectionsCount } = Astro.props

const meta = {
  description: 'Some posts or archives of my blog',
  title: 'Blog'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← 上一页`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `下一页 →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta} back='/'>
  <main class='site-page-main'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Blog</h1>
    </div>
    {
      page.data.length === 0 ? (
        <p>还没有文章。</p>
      ) : (
        <div class='listing-layout'>
          <section aria-label='文章列表' class='animate' id='content'>
            {/* header */}
            <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
              <span class='text-muted-foreground'>
                第 {page.currentPage} 页 · 本页 {page.data.length} 篇，共 {collectionsCount} 篇
              </span>
              <TextArrowLink href='/archives'>按年份查看全部文章</TextArrowLink>
            </div>
            {/* posts */}
            <ul class='flex flex-col gap-y-4 text-start'>
              {page.data.map((post) => (
                <PostPreview {post} detailed />
              ))}
            </ul>
            <Paginator {...paginationProps} />
          </section>

          <TagSidebar section='blog' />
        </div>
      )
    }
  </main>
</PageLayout>

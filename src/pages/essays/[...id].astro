---
import { getCollection } from 'astro:content'

import { getMusingUrl } from '@/utils/posts'
export const prerender = true
export async function getStaticPaths() {
  // Essays moved to the musings collection; keep old /essays/<id> links working via 301.
  const essays = await getCollection('musings', ({ data }) => data.section === 'essays')
  return essays.map((post) => ({ params: { id: post.id }, props: { target: getMusingUrl(post) } }))
}
const { target } = Astro.props
return Astro.redirect(target, 301)
---

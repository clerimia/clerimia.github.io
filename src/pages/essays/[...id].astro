---
import { getPosts, getPostUrl } from '@/utils/posts'
export const prerender = true
export async function getStaticPaths() {
  const posts = await getPosts('essays')
  return posts.map((post) => ({ params: { id: post.id }, props: { target: getPostUrl(post) } }))
}
const { target } = Astro.props
return Astro.redirect(target, 301)
---

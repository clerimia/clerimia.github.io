---
import { getCollection } from 'astro:content'

export const prerender = true
export async function getStaticPaths() {
  // Essays moved to the musings collection; keep old /essays/<page> links working via 301.
  const essays = await getCollection('musings', ({ data }) => data.section === 'essays')
  return essays.map(() => ({ params: { page: undefined } }))
}
return Astro.redirect('/musings', 301)
---

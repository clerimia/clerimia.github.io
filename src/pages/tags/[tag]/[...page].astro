---
import type { GetStaticPaths } from 'astro'
import RedirectPage from '@/components/RedirectPage.astro'
import { contentSections, getTagPaths, getTagUrl } from '@/utils/tags'

// Old unscoped links resolve to one section, preferring Blog for shared tag names.
export const getStaticPaths = (async ({ paginate }) => {
  const claimedTags = new Set<string>()
  const paths = []
  for (const section of contentSections) {
    const sectionPaths = await getTagPaths(section, paginate)
    const available = sectionPaths.filter((path) => !claimedTags.has(path.params.tag!))
    for (const path of available) {
      const suffix = path.props.page.currentPage > 1 ? `/${path.props.page.currentPage}` : ''
      paths.push({
        params: path.params,
        props: { target: getTagUrl(section, path.params.tag!) + suffix }
      })
    }
    for (const path of available) claimedTags.add(path.params.tag!)
  }
  return paths
}) satisfies GetStaticPaths

interface Props {
  target: string
}

const { target } = Astro.props
---

<RedirectPage to={target} label='对应标签页' />

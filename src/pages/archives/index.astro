---
import PostPreview from '@/components/PostPreview.astro'
import { groupCollectionsByYear } from 'astro-pure/server'
import { getPosts } from '@/utils/posts'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

const allPosts = await getPosts('blog')
const allPostsByDate = allPosts
const allPostsByYear = groupCollectionsByYear<'blog'>(allPostsByDate)

const meta = {
  description: 'A list of all the years of creating my posts',
  title: 'Archives'
}
---

<PageLayout {meta}>
  <Button title='返回' href='/blog' variant='back' />

  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Archives</h1>
    </div>

    {allPosts.length === 0 && <p>No posts yet.</p>}

    <section id='content' class='animate' aria-label='Blog post list'>
      {
        allPostsByYear.map(([year, posts]) => (
          <section class='mt-12' aria-label={`${year} 年文章`}>
            <div class='mb-3 flex items-baseline gap-3'>
              <h2 class='text-xl font-medium'>{year}</h2>
              <p class='text-sm text-muted-foreground'>{posts.length} 篇文章</p>
            </div>
            <ul class='flex flex-col text-start'>
              {posts.map((p) => (
                <PostPreview post={p} plain />
              ))}
            </ul>
          </section>
        ))
      }
    </section>
  </main>
</PageLayout>

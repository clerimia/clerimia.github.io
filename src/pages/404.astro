---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  description: '页面不存在',
  title: '404'
}
---

<PageLayout {meta}>
  <div class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-muted-foreground'>这个地址下面没有页面。</p>
    <p class='text-lg'>可能是链接写错了，也可能是文章被挪走了。</p>
    <div class='mt-6 flex flex-wrap items-center justify-center gap-3'>
      <Button title='返回首页' href='/' variant='ahead' />
      <Button title='浏览文章' href='/blog' variant='ahead' />
      <Button title='搜索站点' href='/search' variant='ahead' />
    </div>
  </div>
</PageLayout>

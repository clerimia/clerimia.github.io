---
import { getCollection } from 'astro:content'

export const prerender = true
export async function getStaticPaths() {
  // Notes moved from /docs to /notes; keep old links working via 301.
  const notes = await getCollection('notes')
  return [...notes.map((note) => ({ params: { id: note.id } })), { params: { id: undefined } }]
}
const { id } = Astro.params
return Astro.redirect(id ? `/notes/${id}` : '/notes', 301)
---

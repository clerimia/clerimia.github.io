---
import { Button } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import TagSidebar from '@/components/tags/TagSidebar.astro'
import { integ } from '@/site-config'

import NotesContents from './_NotesContents.astro'

const meta = {
  title: 'Notes',
  description: '学习笔记与踩坑记录。'
}
---

<PageLayout {meta}>
  <Button title='返回' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Notes</h1>
    </div>

    <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
      <div id='content' class={cn('animate min-w-0 max-w-none', integ.typography.class)}>
        <NotesContents title={false} />
      </div>
      <TagSidebar section='notes' />
    </div>
  </main>
</PageLayout>

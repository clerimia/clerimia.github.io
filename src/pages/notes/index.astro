---
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import TagSidebar from '@/components/tags/TagSidebar.astro'
import { integ } from '@/site-config'

import NotesContents from './_NotesContents.astro'

const meta = {
  title: 'Notes',
  description: '学习笔记与踩坑记录。'
}
---

<PageLayout {meta} back='/'>
  <main class='site-page-main'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Notes</h1>
    </div>

    <div class='listing-layout'>
      <div id='content' class={cn('animate min-w-0 max-w-none', integ.typography.class)}>
        <NotesContents title={false} />
      </div>
      <TagSidebar section='notes' />
    </div>
  </main>
</PageLayout>

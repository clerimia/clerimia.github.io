---
import { render, type CollectionEntry } from 'astro:content'
import { getBlogCollection, sortMDByDate } from '@/lib/content'
import { Pencil } from 'lucide-react'

import PageLayout from '@/layouts/ContentLayout.astro'
import PostTOC from '@/components/blog/PostTOC.astro'
import MediumZoom from '@/components/site/MediumZoom.astro'
import TagLinks from '@/components/tags/TagLinks.astro'
import { buttonVariants } from '@/components/ui/button'
import { Card, CardContent } from '@/components/ui/card'

import NotesContents from './_NotesContents.astro'

export const prerender = true

export async function getStaticPaths() {
  const posts = sortMDByDate(await getBlogCollection('notes'))
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post }
  }))
}

type Props = {
  post: CollectionEntry<'notes'>
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const { description, title } = post.data

const editPath = `https://github.com/clerimia/clerimia.github.io/edit/main/${post.filePath}`
---

<PageLayout
  meta={{
    description,
    title,
    publishedDate: post.data.publishDate?.toISOString(),
    updatedDate: post.data.updatedDate?.toISOString(),
    tags: post.data.tags
  }}
  back='/notes'
  hasSidebar
>
  <Fragment slot='sidebar'>
    {!!headings.length && <PostTOC {headings} />}
    <NotesContents class='docs-toc block mt-3' />
  </Fragment>

  <Fragment slot='header'>
    <h1 class='text-2xl font-medium sm:mb-2 sm:text-3xl'>
      {title}
    </h1>
    <TagLinks {post} class='mt-4' />
    <div class='mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs leading-6 text-muted-foreground'>
      {
        // Description
        description && (
          <blockquote class='text-sm italic text-muted-foreground'>
            <q>{description}</q>
          </blockquote>
        )
      }
    </div>
    {

        /* Show more docs collapse on small screen */
        // <Collapse class='md:hidden' title='See more docs'>
        //   <DocsContents title={false} />
        // </Collapse>
    }
  </Fragment>

  <Content />

  <div slot='bottom'>
    <a
      class={buttonVariants({ variant: 'outline' })}
      data-slot='button'
      data-variant='outline'
      href={editPath}
      target='_blank'
      rel='noopener noreferrer'
    >
      <Pencil aria-hidden='true' />
      在 GitHub 编辑
    </a>
    {/* Show docs contents */}
    <Card className='mt-3 gap-0 rounded-xl bg-transparent px-4 py-3 sm:py-4 md:mt-6'>
      <CardContent className='p-0'>
        <NotesContents />
      </CardContent>
    </Card>
  </div>
</PageLayout>
<MediumZoom />

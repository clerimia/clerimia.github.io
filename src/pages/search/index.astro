---
import PageLayout from '@/layouts/BaseLayout.astro'
import SiteSearch from '@/components/SiteSearch.astro'
import { integ } from '@/site-config'

const meta = {
  description: '搜索站内文章',
  title: 'Search'
}
---

<PageLayout {meta} back='/blog'>
  <main class='site-page-main'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Search</h1>
    </div>

    <div id='content' class='animate'>
      {
        integ.pagefind ? (
          <>
            <p>输入关键词，可以搜到文章标题、正文和代码块。</p>
            <SiteSearch />
          </>
        ) : (
          <p>站内搜索未启用。</p>
        )
      }
    </div>
  </main>
</PageLayout>

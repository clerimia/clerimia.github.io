---
import { CardList } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ, terms } from '@/site-config'

const meta = {
  title: '站点政策',
  description: '了解本站的隐私政策、使用条款、版权声明与免责声明。'
}
---

<PageLayout {meta} back='/'>
  <main class='site-page-main'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>站点政策</h1>
    </div>

    <div id='content' class={cn('animate mt-8 max-w-none md:min-w-[45ch]', integ.typography.class)}>
      <p>以下页面说明本站如何处理隐私、内容使用与版权等事项。</p>
      <CardList {...terms} title='政策与说明' />
    </div>
  </main>
</PageLayout>

---
import { type CollectionEntry, render } from 'astro:content'
import { Button, FormattedDate } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostLayout from '@/layouts/BlogPost.astro'
import { integ } from '@/site-config'
import { getMusings, type MusingEntry } from '@/utils/posts'

export const prerender = true

export async function getStaticPaths() {
  const entries = await getMusings()
  const posts = entries.filter((post): post is CollectionEntry<'blog'> => post.collection === 'blog')
  return entries.map((post) => ({
    params: { id: post.id },
    props: { post, posts }
  }))
}

type Props = {
  post: MusingEntry
  posts: CollectionEntry<'blog'>[]
}

const { post, posts } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const { title, publishDate } = post.data

const meta = {
  title: title || '随笔',
  description: '日记随感与短随想。'
}
---

{post.collection === 'blog' ? (
  <PostLayout {post} {posts} {headings} {remarkPluginFrontmatter}>
    <Content />
  </PostLayout>
) : (
<PageLayout {meta}>
  <Button title='返回' href='/musings' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <div class='flex flex-wrap items-baseline gap-x-4'>
        <FormattedDate date={publishDate} class='text-sm' />
        {title && <h1 class='text-3xl font-medium'>{title}</h1>}
      </div>
    </div>

    <div id='content' class={cn('animate mt-6 max-w-none md:min-w-[45ch]', integ.typography.class)}>
      <Content />
    </div>
  </main>
</PageLayout>
)}

---
import { BackToTop } from 'astro-pure/components/pages'
import type { SiteMeta } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

interface Props {
  meta: SiteMeta
  back?: string
  hasSidebar?: boolean
  searchIndex?: boolean
}

const { meta, back = '/', hasSidebar = false, searchIndex = true, ...props } = Astro.props
---

<PageLayout {meta} {back} {...props}>
  <main
    class:list={[
      'site-page-main',
      'article-layout',
      { 'article-layout--with-sidebar': hasSidebar }
    ]}
  >
    {
      hasSidebar && (
        <>
          <aside
            id='sidebar'
            class='article-sidebar'
            aria-label='页面目录'
            tabindex='-1'
            data-pagefind-ignore
            inert
          >
            <slot name='sidebar' />
          </aside>
          <div id='sidebar-shade' class='sidebar-shade' aria-hidden='true' />
        </>
      )
    }

    <article class='reading-column min-w-0 grow' data-pagefind-body={searchIndex ? '' : undefined}>
      {/* Content header */}
      <div id='content-header' class='animate'>
        <slot name='header' />
      </div>

      {/* Content */}
      <div
        id='content'
        class={cn('max-w-none animate mt-8 overflow-x-hidden', integ.typography.class)}
      >
        <slot />
      </div>
    </article>
  </main>

  <div class='article-bottom mt-6' data-pagefind-ignore>
    <div class='article-bottom__main text-muted-foreground'>
      <slot name='bottom' />
    </div>
    <div class='article-bottom__aside'>
      <slot name='bottom-sidebar' />
    </div>
  </div>

  <BackToTop header='content-header' content='content'>
    {
      hasSidebar && (
        <button
          slot='other-icons'
          id='sidebar-btn'
          class='article-directory-fab'
          data-sidebar-trigger
          type='button'
          aria-label='展开目录'
          aria-controls='sidebar'
          aria-expanded='false'
          data-pagefind-ignore
        >
          <Icon name='list' />
        </button>
      )
    }
  </BackToTop>
</PageLayout>

<script>
  const sidebarButton = document.getElementById('sidebar-btn')
  const sidebarTriggers = [...document.querySelectorAll<HTMLElement>('[data-sidebar-trigger]')]
  const sidebar = document.getElementById('sidebar')
  const sidebarShade = document.getElementById('sidebar-shade')
  const contentFrame = document.getElementById('main-content')
  let sidebarReturnFocus: HTMLElement | null = sidebarButton

  function setSidebar(open: boolean, restoreFocus = true) {
    if (!sidebar || !sidebarShade || !sidebarButton) return
    if (open) sidebar.inert = false
    else if (restoreFocus) sidebarReturnFocus?.focus({ preventScroll: true })
    sidebar.classList.toggle('show', open)
    sidebarShade.classList.toggle('show', open)
    sidebarTriggers.forEach((trigger) => trigger.setAttribute('aria-expanded', String(open)))
    if (open) {
      sidebar.setAttribute('role', 'dialog')
      sidebar.setAttribute('aria-modal', 'true')
      ;(sidebar.querySelector<HTMLElement>('a[href]') ?? sidebar).focus({ preventScroll: true })
    } else {
      sidebar.removeAttribute('role')
      sidebar.removeAttribute('aria-modal')
      sidebar.inert = getComputedStyle(sidebar).position !== 'sticky'
    }
  }

  sidebarTriggers.forEach((trigger) =>
    trigger.addEventListener('click', () => {
      sidebarReturnFocus = trigger.closest('.site-nav')
        ? document.getElementById('site-menu-toggle')
        : trigger
      setSidebar(true)
    })
  )
  sidebarShade?.addEventListener('click', () => setSidebar(false))

  // Clicking a same-page entry closes the drawer and moves focus to the heading.
  sidebar?.addEventListener('click', (event) => {
    if (!sidebar.classList.contains('show')) return
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href]')
    if (!link) return
    const target = new URL(link.href, window.location.href)
    if (target.pathname !== window.location.pathname || !target.hash) return
    const heading = document.getElementById(decodeURIComponent(target.hash.slice(1)))
    setSidebar(false, false)
    if (heading) {
      if (!heading.hasAttribute('tabindex')) {
        heading.setAttribute('tabindex', '-1')
        heading.addEventListener('blur', () => heading.removeAttribute('tabindex'), { once: true })
      }
      heading.focus({ preventScroll: true })
    }
  })

  document.addEventListener('keydown', (event) => {
    if (!sidebar?.classList.contains('show')) return
    if (event.key === 'Escape') {
      event.preventDefault()
      setSidebar(false)
    } else if (event.key === 'Tab') {
      const controls = Array.from(
        sidebar.querySelectorAll<HTMLElement>('a[href], button, [tabindex="0"]')
      ).filter((element) => element.tabIndex >= 0 && element.getClientRects().length > 0)
      const first = controls[0]
      const last = controls[controls.length - 1]
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last?.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first?.focus()
      }
    }
  })

  // 容器查询是并列布局的唯一判断来源；窗口改变时同步关闭已打开的抽屉。
  if (contentFrame && sidebar) {
    new ResizeObserver(() => {
      const wide = getComputedStyle(sidebar).position === 'sticky'
      const triggerFocused = sidebarTriggers.includes(document.activeElement as HTMLElement)
      sidebarTriggers.forEach((trigger) => {
        trigger.hidden = wide
      })
      if (!sidebar.classList.contains('show')) sidebar.inert = !wide
      if (wide && triggerFocused)
        (sidebar.querySelector<HTMLElement>('a[href]') ?? sidebar).focus({ preventScroll: true })
      if (!sidebar.classList.contains('show') || !wide) return
      const hadFocus = sidebar.contains(document.activeElement)
      setSidebar(false, false)
      if (hadFocus) (sidebar.querySelector<HTMLElement>('a[href]') ?? sidebar).focus()
    }).observe(contentFrame)
  }

  const actionButtons = document.getElementById('action-buttons')
  const backToTop = actionButtons?.querySelector<HTMLElement>('scroll-button')
  if (actionButtons && backToTop && sidebarButton) {
    const syncBackToTopAvailability = () => {
      backToTop.inert = !sidebarButton.hidden && !actionButtons.classList.contains('show')
    }
    syncBackToTopAvailability()
    const actionObserver = new MutationObserver(syncBackToTopAvailability)
    actionObserver.observe(actionButtons, { attributes: true, attributeFilter: ['class'] })
    actionObserver.observe(sidebarButton, { attributes: true, attributeFilter: ['hidden'] })
  }
</script>
<style>
  .article-layout {
    min-width: 0;
  }

  .article-directory-fab {
    display: inline-grid;
    place-items: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--motion-feedback) var(--motion-feedback-easing),
      border-color var(--motion-feedback) var(--motion-feedback-easing);
  }
  .article-directory-fab[hidden] {
    display: none;
  }
  .article-directory-fab:hover {
    color: var(--color-action);
    border-color: var(--color-action);
  }
  .article-directory-fab :global(svg) {
    width: 19px;
    height: 19px;
  }

  :global(#action-buttons:has(#sidebar-btn:not([hidden]))) {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-end;
    gap: var(--space-2) !important;
    inset-inline-end: max(20px, env(safe-area-inset-right, 0px));
    bottom: max(20px, env(safe-area-inset-bottom, 0px));
    transform: none !important;
  }

  :global(#action-buttons:has(#sidebar-btn:not([hidden])) scroll-button) {
    order: 1;
  }

  :global(#action-buttons:has(#sidebar-btn:not([hidden])) #to-top-btn) {
    min-width: 44px;
    min-height: 44px;
  }

  .article-directory-fab:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .article-directory-fab {
    order: 2;
  }

  .article-sidebar {
    position: fixed;
    z-index: 40;
    inset: 0 0 0 auto;
    display: block;
    width: min(320px, 85vw);
    height: 100dvh;
    overflow-y: auto;
    padding: max(var(--space-6), env(safe-area-inset-top, 0px))
      max(var(--space-4), env(safe-area-inset-right, 0px))
      max(var(--space-6), env(safe-area-inset-bottom, 0px)) var(--space-6);
    border-left: 1px solid var(--color-border);
    border-radius: var(--radius-panel) 0 0 var(--radius-panel);
    background: var(--color-surface);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(8px);
    transition:
      opacity var(--motion-overlay) var(--motion-overlay-easing),
      transform var(--motion-overlay) var(--motion-overlay-easing),
      visibility 0s linear var(--motion-overlay);
  }

  .article-sidebar.show {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
    transition-delay: 0s;
  }

  .sidebar-shade {
    position: fixed;
    z-index: 31;
    inset: 0;
    background: #00000091;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--motion-overlay) var(--motion-overlay-easing),
      visibility 0s linear var(--motion-overlay);
  }
  .sidebar-shade.show {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .article-sidebar :global(.toc-item) {
    min-height: 44px;
    padding-block: var(--space-2);
  }

  .article-sidebar :global(.docs-item > a) {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .article-bottom__main {
    width: 100%;
    max-width: var(--layout-reading);
    min-width: 0;
  }

  .article-bottom__aside:empty {
    display: none;
  }

  /* 只有页框实际容得下 680 + 32 + 224px 才并列。 */
  @media (min-width: 1000px) {
    @container site-content (min-width: 936px) {
      .article-layout--with-sidebar {
        display: grid;
        grid-template-columns: minmax(0, var(--layout-reading)) var(--layout-aside);
        align-items: start;
        gap: var(--space-8);
      }

      .article-sidebar {
        position: sticky;
        inset: 5rem auto auto;
        grid-column: 2;
        grid-row: 1;
        display: block;
        width: var(--layout-aside);
        height: auto;
        max-height: calc(100dvh - 7rem);
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: none;
        transition: none;
      }

      .article-sidebar.show {
        animation: none !important;
        transform: none;
      }

      #sidebar-btn,
      #sidebar-shade {
        display: none !important;
      }

      .article-bottom:has(.article-bottom__aside:not(:empty)) {
        display: grid;
        grid-template-columns: minmax(0, var(--layout-reading)) var(--layout-aside);
        gap: var(--space-8);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #sidebar,
    #sidebar-shade {
      transition: none !important;
    }
  }
</style>

---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom } from 'astro-pure/components/pages'
import Hero from '@/components/blog/Hero.astro'
import Copyright from '@/components/blog/Copyright.astro'
import PostTOC from '@/components/blog/PostTOC.astro'
import config from 'virtual:config'
import PageLayout from '@/layouts/ContentLayout.astro'
import { Comment, PageInfo } from '@/components/comments'
import { getPostSectionUrl } from '@/utils/posts'
import { getEntrySection } from '@/utils/tags'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment
} = data

const sectionPath = getPostSectionUrl(Astro.props.post)

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
const hasSidebar = headings.some((heading) => heading.depth <= 3)
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  back={sectionPath}
  {hasSidebar}
>
  {hasSidebar && <PostTOC {headings} slot='sidebar' />}

  <Fragment slot='header'>
    <Hero {data} {remarkPluginFrontmatter} section={getEntrySection(Astro.props.post)} />
    {!isDraft && enableComment && <PageInfo comment class='mt-4' />}
  </Fragment>

  <slot />

  <Fragment slot='bottom'>
    <Copyright {data} />
    <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />
    {
      /* 评论区：与页头的「参与讨论」共用 enableComment，
         保证不会出现「有入口没评论区」的死锚点。 */
    }
    {!isDraft && enableComment && (
      <Comment
        class='mt-3 sm:mt-6'
        discussionTerm={
          data.section === 'essays' ? `essays/${id}` : undefined
        }
      />
    )}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}

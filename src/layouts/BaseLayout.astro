---
import { ThemeProvider } from 'astro-pure/components/basic'
import { Button } from 'astro-pure/user'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import SiteHeader from '@/components/SiteHeader.astro'
import TerminalDialog from '@/components/TerminalDialog.astro'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'
import '@/assets/styles/header.css'

interface Props {
  meta: SiteMeta
  back?: string
}

const {
  meta: { articleDate, description = config.description, ogImage, title },
  back,
  ...props
} = Astro.props
const isHome = Astro.url.pathname === '/'
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body class='site-body' {...props}>
    <a class='skip-link' href='#main-content'>跳到正文</a>
    <div
      id='main-container'
      class='site-shell'
    >
      <SiteHeader />
      <div
        id='main-content'
        class:list={['site-content', { 'site-content--inner': !isHome }]}
        tabindex='-1'
      >
        {back && <Button title='返回' href={back} variant='back' class='site-back' />}
        <slot />
      </div>
      <SiteFooter />
    </div>
    <TerminalDialog />
  </body>
</html>

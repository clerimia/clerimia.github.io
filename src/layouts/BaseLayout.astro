---
import type { SiteMeta } from '@/lib/site-types'
import { cn } from '@/lib/ui'
import { ArrowLeft } from 'lucide-react'

import BaseHead from '@/components/site/BaseHead.astro'
import SiteFooter from '@/components/site/SiteFooter.astro'
import SiteHeader from '@/components/site/SiteHeader.astro'
import TerminalDialog from '@/components/site/TerminalDialog.astro'
import ThemeProvider from '@/components/site/ThemeProvider.astro'
import { buttonVariants } from '@/components/ui/button'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/styles/global.css'

interface Props {
  meta: SiteMeta & {
    publishedDate?: string
    updatedDate?: string
    tags?: string[]
  }
  back?: string
}

const {
  meta: {
    articleDate,
    description = config.description,
    ogImage,
    publishedDate,
    title,
    updatedDate,
    tags
  },
  back,
  ...props
} = Astro.props
const isHome = Astro.url.pathname === '/'
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {publishedDate} {title} {updatedDate} {tags} />
    <ThemeProvider />
  </head>

  <body class='site-body' {...props}>
    <a class='skip-link' href='#main-content'>跳到正文</a>
    <div id='main-container' class='site-shell'>
      <SiteHeader />
      <div
        id='main-content'
        class:list={['site-content', { 'site-content--inner': !isHome }]}
        tabindex='-1'
      >
        {
          back && (
            <a
              class={cn(
                buttonVariants({ variant: 'outline', size: 'sm' }),
                'site-back text-muted-foreground'
              )}
              data-slot='button'
              data-variant='outline'
              data-size='sm'
              href={back}
              data-astro-prefetch
            >
              <ArrowLeft aria-hidden='true' />
              返回
            </a>
          )
        }
        <slot />
      </div>
      <SiteFooter />
    </div>
    <TerminalDialog />
  </body>
</html>

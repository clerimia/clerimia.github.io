---
import type { MarkdownHeading, MarkdownLayoutProps } from 'astro'

import { Icon } from 'astro-pure/user'
import PostTOC from '@/components/blog/PostTOC.astro'
import PageLayout from '@/layouts/ContentLayout.astro'

type Props = MarkdownLayoutProps<{
  title: string
  description: string
  heroImage?: { src: string }
  language?: string
  back?: string
}> & {
  headings: MarkdownHeading[]
}

const { frontmatter, headings } = Astro.props
const { title, description, heroImage, language, back } = frontmatter
const hasSidebar = headings.some((heading) => heading.depth <= 3)
---

<PageLayout meta={{ title, description, ogImage: heroImage?.src }} back={back ?? '/'} {hasSidebar} searchIndex={false}>
  {hasSidebar && <PostTOC {headings} slot='sidebar' />}
  <Fragment slot='header'>
    <h1 class='text-2xl font-medium sm:mb-2 sm:text-3xl'>{title}</h1>
    <div class='mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs leading-6 text-muted-foreground'>
      {language && (
        <span class='flex items-center gap-1'>
          <Icon name='earth' />
          {language}
        </span>
      )}
      {description && (
        <blockquote class='text-sm italic text-muted-foreground'>
          <q>{description}</q>
        </blockquote>
      )}
    </div>
  </Fragment>
  <slot />
</PageLayout>
